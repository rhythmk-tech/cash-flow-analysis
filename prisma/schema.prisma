generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  companyName  String
  createdAt    DateTime @default(now())

  // When this account holder agreed to the Terms of Service / Privacy Policy at signup. Null
  // for accounts created before this was tracked — nothing is backfilled, since we can't
  // actually know whether/when they agreed.
  termsAcceptedAt DateTime?

  // Grants access to /admin — aggregate, cross-company usage analytics for operating the
  // product. Deliberately separate from the in-company owner/admin/editor/viewer roles above,
  // which only ever govern a single company's own data. Not settable through any UI; set
  // directly in the database for whichever account(s) should have it.
  isPlatformAdmin Boolean @default(false)

  // Billing — dormant scaffolding for a future paid plan. Only meaningful when this user IS a
  // company (activeCompanyId is null), same as the forecast settings below. Nothing in the app
  // reads these to gate a feature today: the product is free for everyone regardless of what's
  // here. Populated by the Stripe webhook once STRIPE_SECRET_KEY is configured (see
  // lib/stripe.ts) and a checkout actually completes; until then every row stays entirely null.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  // Mirrors the Stripe Subscription.status values verbatim (e.g. "active", "trialing",
  // "past_due", "canceled") rather than a bespoke enum, so the webhook handler can just pass
  // it through without a translation table that has to be kept in sync with Stripe's own states.
  subscriptionStatus   String?
  subscriptionPlan     String?
  currentPeriodEnd     DateTime?

  // Forecast settings — only meaningful when this user IS a company (activeCompanyId is null).
  // Members who joined another company via invite read/write the owner's row instead.
  startingBalance Float    @default(0)
  totalWeeks      Int      @default(12)
  bearPct         Float    @default(-10)
  bullPct         Float    @default(10)
  forecastStart   DateTime @default(now())

  // How many months the read-only monthly summary (below the weekly Detailed Forecast) covers.
  // Independent of totalWeeks — the monthly view is a longer-range roll-up of the same line
  // items, not derived from the weekly grid, so it can run well past the weekly window.
  monthlySummaryMonths Int @default(12)

  // Manual drag-and-drop order for Detailed Forecast rows, as an ordered list of lineLabels.
  // Empty means "no custom order yet" — rows fall back to first-seen order, matching the
  // behavior every existing account already has today. Any label not present here (e.g. a
  // brand-new item) is appended after the ordered ones. See lib/forecast.ts's sortLabels.
  incomeRowOrder  String[] @default([])
  expenseRowOrder String[] @default([])

  // If set, this user operates on another user's (the "company owner's") data instead of
  // their own. Null means this user is their own company.
  activeCompanyId String?
  companyOwner    User?    @relation("CompanyMembers", fields: [activeCompanyId], references: [id], onDelete: SetNull)
  members         User[]   @relation("CompanyMembers")

  // Only meaningful when activeCompanyId is set (i.e. this row is a team member, not an owner).
  // "admin" | "editor" | "viewer" — see lib/roles.ts. The owner's own permissions are implicit
  // and not stored here.
  role String @default("editor")

  // Tracks the last negative-balance alert email sent for this company, so a mutation that
  // leaves the same week still-negative doesn't re-fire the email every time. See lib/alerts.ts.
  lastNegativeAlertWeek Int?
  lastNegativeAlertAt   DateTime?

  // Data owned by this row when it is acting as a company (activeCompanyId is null on the owner).
  items     LineItem[]
  overrides Override[]
  actuals   Actual[]

  passwordResetTokens PasswordResetToken[]

  // Dormant scaffolding for a future QuickBooks Online sync — see lib/quickbooks.ts. Null/absent
  // until STRIPE-style env vars (QUICKBOOKS_CLIENT_ID etc.) are configured and the owner actually
  // completes the OAuth connect flow; nothing reads this to gate any feature today.
  quickBooksConnection QuickBooksConnection?
}

model Invitation {
  id         String    @id @default(cuid())
  companyId  String // the User.id whose company this invite grants access to
  email      String
  role       String    @default("editor") // "admin" | "editor" | "viewer" — copied to User.role on acceptance
  token      String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?

  @@index([companyId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

// One row per company that has connected QuickBooks Online, created only once the OAuth
// connect flow (app/api/quickbooks/connect + callback) actually completes. Tokens are stored
// in plain text rather than encrypted — acceptable for now since the whole feature is dormant
// and unreachable without QUICKBOOKS_CLIENT_ID/SECRET configured, but worth encrypting at rest
// before this goes live for real customers.
model QuickBooksConnection {
  id     String @id @default(cuid())
  userId String @unique // company owner's User.id — only the owner can connect/disconnect
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  realmId String // QuickBooks' own company identifier — required on every API call

  accessToken           String
  refreshToken          String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime // refresh tokens are rotated on every use and expire after ~100 days of no use

  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model LineItem {
  id        String   @id @default(cuid())
  userId    String // company owner's User.id, not necessarily the creator
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "income" | "expense"
  category  String
  name      String
  amount    Float
  frequency String // "onetime" | "weekly" | "biweekly" | "monthly"
  startDate DateTime // absolute calendar date this item first occurs — NOT relative to forecastStart,
  // so editing the forecast's Week-1 start date never silently moves an item's real-world date.
  // Its position within the current forecast window is recomputed on the fly (see occurrencesFor).
  endDate   DateTime? // optional last date a recurring item still occurs (inclusive). Null means
  // "keeps recurring through the end of whatever window is being computed" — today's behavior,
  // unchanged for every existing row. Irrelevant for onetime items (they only ever fire once).
  lineLabel String
  createdAt DateTime @default(now())

  // Set only for items created by a QuickBooks sync (see app/api/quickbooks/sync) — the source
  // transaction's QuickBooks Id, namespaced by entity type (e.g. "Purchase:123") since QuickBooks
  // Ids are only unique within one entity type, not globally. Null for every manually-added or
  // CSV-imported item. The unique constraint below is what makes re-running a sync safe: a
  // transaction that was already imported is skipped instead of creating a duplicate line item.
  quickBooksTxnId String?

  @@unique([userId, quickBooksTxnId])
  @@index([userId])
}

model Override {
  id     String @id @default(cuid())
  userId String // company owner's User.id, not necessarily the creator
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   String // "income" | "expense"
  label  String
  week   Int
  value  Float

  @@unique([userId, type, label, week])
  @@index([userId])
}

// One entry per mutation a team member makes, for accountability once more than one person
// can edit a company's data. actorEmail is denormalized so history stays readable even after
// the actor is later removed from the team.
model ActivityLog {
  id          String   @id @default(cuid())
  companyId   String
  actorUserId String
  actorEmail  String
  action      String
  summary     String
  createdAt   DateTime @default(now())

  @@index([companyId, createdAt])
}

// A user-reported actual closing balance for a past week, compared against what the forecast
// predicted for that week to show how accurate the model has been.
model Actual {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  week      Int
  // Each independently optional — a week can have any subset recorded (e.g. actual income
  // known before the exact closing balance is checked). balance was previously required;
  // loosening it to optional keeps every existing row's value exactly as it was.
  balance   Float?
  income    Float?
  expense   Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, week])
  @@index([userId])
}
